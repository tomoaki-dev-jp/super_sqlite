{
  // F5 でこの拡張機能を「拡張機能開発ホスト」上で起動します。
  // 詳細: https://code.visualstudio.com/api/get-started/your-first-extension
  "version": "0.2.0",
  "configurations": [
    {
      "name": "拡張機能を実行",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "${defaultBuildTask}"
    }
  ]
}
